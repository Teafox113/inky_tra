{
  "name": "inky-translation-fork",
  "productName": "Inky Translation Fork",
  "version": "1.8.0-dev.4",
  "description": "Inky 繁體中文介面與 AI 翻譯擴充版",
  "main": "main-process/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teafox113/inky_tra.git"
  },
  "scripts": {
    "postinstall": "node ../build/createDocumentnavigation.js && markdown-html resources/Documentation/WritingWithInk.md -s resources/Documentation/documentation.css -o renderer/documentation/embedded.html",
    "start": "electron main-process/main.js",
    "test": "node --test ../tests/*.test.js",
    "generate-locale": "node ../build/generateLocale.js",
    "build-package": "node ../scripts/build-win.js"
  },
  "keywords": [
    "ink",
    "narrative",
    "editor"
  ],
  "author": "inkle Ltd",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Teafox113/inky_tra/issues"
  },
  "homepage": "https://github.com/Teafox113/inky_tra",
  "dependencies": {
    "chokidar": "^3.6.0",
    "fuzzaldrin-plus": "^0.6.0",
    "inkjs": "2.2.3",
    "lodash": "^4.17.21",
    "mkdirp": "^3.0.1",
    "randomstring": "^1.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.2",
    "chai": "^5.1.1",
    "chai-as-promised": "^7.1.2",
    "electron": "^30.0.4",
    "jsdom": "^24.0.0",
    "markdown-html": "^0.0.8",
    "mocha": "^10.4.0"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.6"
  },
  "contributors": [
    "FloofyFox"
  ]
}
